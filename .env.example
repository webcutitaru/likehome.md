# Copiați ca .env (nu se versionează).
# Local (MAMP): .env în rădăcina proiectului (lângă config.php).
# cPanel producție: plasați .env în afara public_html, ex. /home/likehome/.env
# Opțional: LH_ENV_PATH=/home/likehome în php.ini / cPanel Environment Variables

APP_ENV=local
APP_DEBUG=1
APP_TIMEZONE=Europe/Chisinau

# MAMP local
DB_HOST=localhost
DB_NAME=likehome2_db
DB_USER=root
DB_PASS=root
DB_CHARSET=utf8mb4

# Producție: SITE_BASE_PATH gol sau / ; local MAMP: /likehome2
SITE_BASE_PATH=/likehome2
PUBLIC_SITE_URL=https://www.likehome.md

# Opțional — path absolut pe server
# ERROR_LOG_PATH=/home/likehome/logs/php-error.log

# Mailjet (rezervări, notificări)
MAILJET_API_KEY=
MAILJET_API_SECRET=
BOOKING_MAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=

# Telegram (notificări rezervări)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cron URL securizat (cron/ical_sync.php, cron/checkin_reminder.php)
ICAL_SYNC_SECRET=
CHECKIN_REMINDER_SECRET=

# iCal fetch
ICAL_ALLOW_HTTP=0
ICAL_FETCH_MAX_BYTES=2097152

# Rezervări — rate limit
BOOKING_RATE_LIMIT_MAX=10
BOOKING_RATE_LIMIT_WINDOW=900
BOOKING_RATE_LIMIT_PER_PROPERTY_MAX=0
BOOKING_RATE_LIMIT_PER_PROPERTY_WINDOW=900
BOOKING_PRICE_PREVIEW_RATE_LIMIT_MAX=40
BOOKING_PRICE_PREVIEW_RATE_LIMIT_WINDOW=300

# Upload imagini proprietăți (bytes, implicit 5MB)
UPLOAD_MAX_IMAGE_BYTES=5242880

# Monede afișate
APP_BASE_CURRENCY=MDL
APP_CURRENCY_DISPLAY=

# Analytics (opțional)
GA_MEASUREMENT_ID=
CLARITY_PROJECT_ID=
GOOGLE_MAPS_EMBED_API_KEY=

# Email oaspeți — telefoane coordonatori (multiline)
# BOOKING_GUEST_SUPPORT_PHONES="Andrei — +373 69 397 372\nAurel — +373 69 111 427"

# Debug admin save timings
LH_DEBUG_SAVE_TIMINGS=0
